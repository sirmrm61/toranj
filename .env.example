# --- Core ---
NODE_ENV=development
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string
DATABASE_URL=postgresql://toranj:toranj@localhost:5432/toranj
REDIS_URL=redis://localhost:6379

# --- Object storage (S3 compatible; RustFS in development via docker compose) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=toranj-private
STORAGE_ACCESS_KEY=toranj
STORAGE_SECRET_KEY=toranj-secret
STORAGE_FORCE_PATH_STYLE=true
# Signed URL lifetime in seconds
STORAGE_SIGNED_URL_TTL=300

# --- AI image generation (server/worker only) ---
# AI_PROVIDER=gemini | mock   (mock renders a local composite, no network)
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_TRYON_MODEL=gemini-3.1-flash-image
GEMINI_ASSET_MODEL=gemini-3-pro-image
GEMINI_TIMEOUT_MS=90000

# --- SMS (OTP, booking notifications) ---
# SMS_PROVIDER=kavenegar | mock   (mock logs messages to the server console)
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER=
SMS_OTP_TEMPLATE=
# Phone number(s) of the boutique that receive booking notifications (comma separated)
SHOP_NOTIFY_PHONES=09120000000

# --- Payment gateway ---
# PAYMENT_PROVIDER=zarinpal | mock   (mock simulates the gateway locally)
PAYMENT_PROVIDER=mock
PAYMENT_MERCHANT_ID=
PAYMENT_SANDBOX=true

# --- Business defaults (overridable in admin settings) ---
FREE_QUOTA=3
REFERRAL_REWARD=3
REFERRAL_CAP=10

# --- Admin bootstrap: phone numbers that get the admin role on login (comma separated) ---
ADMIN_PHONES=09120000000

# --- Cron endpoint secret (photo retention cleanup) ---
CRON_SECRET=change-me
